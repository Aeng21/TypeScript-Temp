# ============================================================
# CONTOH FILE .env — salin file ini menjadi ".env" lalu isi sesuai
# konfigurasi database di komputer/server masing-masing.
# File .env yang asli TIDAK di-commit ke git (lihat backend/.gitignore),
# jadi file .env.example inilah yang menjadi dokumentasi variabel apa saja
# yang dibutuhkan aplikasi ini.
# ============================================================

# Alamat host database MySQL. Biasanya 'localhost' kalau MySQL jalan di
# komputer yang sama dengan backend ini.
DB_HOST=localhost

# Nama user MySQL yang dipakai untuk login ke database.
DB_USER=root

# Password untuk user MySQL di atas. Kosongkan hanya jika memang tidak ada
# password (misal setup development lokal tanpa password).
DB_PASSWORD=

# Nama database yang dipakai aplikasi ini (lihat database.sql).
DB_NAME=minecraft_db

# Port tempat server Express ini berjalan.
PORT=3000

# Alamat origin frontend yang diizinkan mengakses API ini lewat CORS.
# Harus sama persis dengan protokol + host + port tempat frontend berjalan.
FRONTEND_URL=http://localhost:2000
