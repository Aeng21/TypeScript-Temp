# File .env berisi kredensial database (user, password) dan konfigurasi lain
# yang berbeda-beda tiap environment (development/production). Sebelumnya file
# ini IKUT TER-COMMIT ke git (tidak ada .gitignore sama sekali), artinya siapa
# pun yang punya akses ke riwayat git bisa melihat kredensial tersebut.
# Gunakan backend/.env.example sebagai contoh/template, lalu buat .env sendiri
# secara lokal (tidak pernah di-commit).
.env

# node_modules berisi ribuan file dependency yang bisa di-generate ulang kapan
# saja lewat `npm install` (berdasarkan package.json + package-lock.json).
# Tidak perlu (dan sebaiknya tidak) ikut disimpan di git karena ukurannya besar
# dan bisa berbeda-beda per sistem operasi.
node_modules
