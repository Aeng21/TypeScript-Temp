# ============================================================
# Contoh isi file .env untuk backend "redirect" (auth).
# ============================================================
# File ini HANYA berisi NAMA variabel + nilai placeholder (bukan kredensial asli), dan AMAN
# untuk ikut di-commit ke git — supaya developer lain (atau diri sendiri di komputer lain)
# tahu variabel apa saja yang wajib diisi tanpa perlu membongkar source code satu-satu.
# Cara pakai: salin file ini menjadi '.env' di folder yang sama, lalu isi nilai aslinya.
# File '.env' yang sungguhan (berisi kredensial asli) SENGAJA diabaikan oleh .gitignore
# supaya tidak pernah ikut ter-commit.

# Alamat server MySQL. Biasanya 'localhost' untuk pengembangan di komputer sendiri.
DB_HOST=localhost
# Nama akun MySQL yang dipakai untuk login ke database.
DB_USER=root
# Kata sandi akun MySQL tersebut. Kosongkan hanya jika akun MySQL memang tanpa password (dev saja).
DB_PASSWORD=
# Nama database yang dipakai backend ini (tabel users & sessions berada di sini).
DB_NAME=auth_db

# Port tempat backend redirect (auth) ini berjalan.
PORT=3001

# Origin frontend redirect (login/register/admin/customer/keranjang), dipakai untuk konfigurasi
# CORS supaya hanya origin ini yang boleh memanggil API dengan cookie session ikut terkirim.
FRONTEND_URL=http://localhost:2001

# Kunci rahasia untuk menandatangani cookie session (connect.sid). WAJIB diisi dengan string
# acak yang panjang & unik di setiap environment (jangan pernah dipakai ulang / dibagikan) —
# siapa pun yang tahu nilai ini bisa memalsukan cookie session milik user lain.
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-di-production

# NODE_ENV menentukan mode server: 'development' (default jika kosong) atau 'production'.
# Mempengaruhi: apakah cookie session wajib HTTPS (secure) dan apakah pesan error internal
# ikut dikirim ke client (lihat server.ts & authController.ts).
NODE_ENV=development
