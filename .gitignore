# Dependencies
node_modules/

# Environment variables (never commit real secrets)
.env
.env.*
!.env.example

# Git safety (avoid accidentally committing nested repos/backups)
.git/
*.git-backup/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
dist-ssr/
build/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.local
